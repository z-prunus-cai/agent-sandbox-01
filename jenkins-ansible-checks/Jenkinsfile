// 示例：给已有的 Ansible 部署流水线加上“部署前检查”和“部署后检查”。说明见同目录的 README.md。
//
// 文件分为三部分：
//   1. 检查目录 checkCatalog()：这个项目有哪些检查、默认策略、允许的参数与默认值（按项目修改）
//   2. 流水线：标记 [新增] 的是接入检查新加的部分，其余代表原有的部署流水线
//   3. 检查引擎：解析本次部署的选择、运行检查、按策略处理失败（一般不需要修改）
//
// 需要的插件：ansible、pipeline-utility-steps（readYaml / writeJSON）、uno-choice（Active Choices，
// 提供可多选的检查列表和随选择变化的参数表单）、Pipeline。

// ===================================================================================
// 1. 检查目录
// ===================================================================================

// 所有检查都在这个 playbook 里，用 tag 区分（tag 名 = 检查名）
def checksPlaybook() { return 'jenkins-ansible-checks/checks.yml' }

// 检查失败时的处理策略：
//   abort  阻塞：停止流水线（构建 FAILURE）
//   warn   非阻塞：标记 UNSTABLE，继续执行
//   ignore 非阻塞：只记录，不影响构建结果
//   ask    暂停，由人选择继续（UNSTABLE）或中止（ABORTED）
//
// 每个检查的字段：
//   phases           允许出现在哪个阶段：pre（部署前）/ post（部署后）
//   policy           默认策略
//   timeout_minutes  超时时间，超时按检查失败处理
//   params           允许的参数及默认值。只有这里列出的参数名能被覆盖，防止传入任意 Ansible 变量。
//                    数字类型的默认值在表单中显示为数字输入框，提交后也按数字传给 Ansible
//   labels           参数在表单中显示的说明
//   required         每次部署必须提供值的参数
def checkCatalog() {
    return [
        // 构建参数页上默认勾选的检查
        defaults: [pre: ['disk_space', 'port_reachable'], post: ['http_health', 'app_version']],
        checks  : [
            disk_space     : [description: '目标主机磁盘剩余空间', phases: ['pre'],
                              policy: 'abort', timeout_minutes: 5,
                              params: [path: '/', min_free_mb: 1024],
                              labels: [path: '要检查的目录或挂载点', min_free_mb: '最少剩余空间（MB）']],
            port_reachable : [description: '目标主机能连通依赖服务的端口', phases: ['pre', 'post'],
                              policy: 'abort', timeout_minutes: 5,
                              // 演示值：真实场景填依赖服务的地址，如数据库 5432
                              params: [target_host: '127.0.0.1', target_port: 18080, timeout_seconds: 10],
                              labels: [target_host: '依赖服务地址', target_port: '依赖服务端口',
                                       timeout_seconds: '等待端口可用的最长时间（秒）']],
            service_running: [description: '目标主机上的系统服务正在运行', phases: ['pre', 'post'],
                              policy: 'warn', timeout_minutes: 5,
                              params: [service_name: ''], required: ['service_name'],
                              labels: [service_name: '服务名，如 nginx']],
            http_health    : [description: '应用 HTTP 健康检查接口', phases: ['post'],
                              policy: 'abort', timeout_minutes: 10,
                              // 演示值：演示应用监听 18080
                              params: [url: 'http://127.0.0.1:18080/health', expected_status: 200,
                                       body_contains: '', max_attempts: 10, delay_seconds: 3],
                              labels: [url: '健康检查地址（在目标主机上请求）', expected_status: '期望的 HTTP 状态码',
                                       body_contains: '响应需包含的文字，留空不检查', max_attempts: '最多请求次数',
                                       delay_seconds: '两次请求的间隔（秒）']],
            app_version    : [description: '已部署的版本号与本次部署一致', phases: ['post'],
                              policy: 'warn', timeout_minutes: 5,
                              // 演示值：与 Deploy 阶段的 app_dir 一致
                              params: [version_file: '/tmp/demo-app/VERSION', expected_version: ''],
                              labels: [version_file: '记录版本号的文件', expected_version: '期望的版本号，留空则为 APP_VERSION']],
        ],
    ]
}

// 检查和部署共用的 ansiblePlaybook 参数。演示用本机作为目标主机；
// 真实环境改为与部署相同的 inventory、credentialsId、installation 等。
def ansibleArgs() {
    return [
        inventoryContent: 'localhost ansible_connection=local ansible_python_interpreter="{{ ansible_playbook_python }}"',
        // inventory: 'inventories/prod/hosts.ini',
        // credentialsId: 'deploy-ssh-key',
    ]
}

// ===================================================================================
// 2. 流水线
// ===================================================================================

// 构建参数用 properties() 定义，而不是 pipeline 中的 parameters {}：检查列表和参数表单要根据
// checkCatalog() 生成。原有的参数（如 APP_VERSION）也一起移到这里，两种写法不能同时使用。
properties([parameters([
        string(name: 'APP_VERSION', defaultValue: '1.0.0', description: '要部署的版本'),
] + checkParameters())])                                                     // [新增] checkParameters()

def checkPlan                                                                // [新增]
def checkResults = []                                                        // [新增]

pipeline {
    agent any

    stages {
        // [新增] 部署前先解析并校验检查计划：检查名、参数写错时直接失败，不会部署到一半
        stage('Resolve checks') {
            steps {
                script {
                    checkPlan = resolveChecks(pre: params.PRE_CHECKS, preOptions: params.PRE_CHECK_OPTIONS,
                            post: params.POST_CHECKS, postOptions: params.POST_CHECK_OPTIONS,
                            plan: params.CHECK_PLAN)
                }
            }
        }

        // [新增]
        stage('Pre-deploy checks') {
            when { expression { checkPlan.pre } }
            steps {
                script {
                    runChecks('pre', checkPlan.pre, checkResults, [deploy_version: params.APP_VERSION])
                }
            }
        }

        // 原有的部署步骤（演示用替身：运行 checks.yml 中的 demo_deploy）
        stage('Deploy') {
            steps {
                script {
                    ansiblePlaybook(ansibleArgs() + [
                            playbook : checksPlaybook(),
                            tags     : 'demo_deploy',
                            extraVars: [app_version: [value: params.APP_VERSION, hidden: false],
                                        app_dir    : [value: '/tmp/demo-app', hidden: false]],
                    ])
                }
            }
        }

        // [新增]
        stage('Post-deploy checks') {
            when { expression { checkPlan.post } }
            steps {
                script {
                    runChecks('post', checkPlan.post, checkResults, [deploy_version: params.APP_VERSION])
                }
            }
        }
    }

    post {
        // [新增] 汇总检查结果并归档 deploy-checks-report.json
        always {
            script {
                reportChecks(checkResults)
            }
        }
        // 部署后的阻塞检查失败也会走到这里，可以在此接入回滚或通知（注意部署前检查失败时并没有部署）
        // failure { ... }
    }
}

// ===================================================================================
// 3. 检查引擎
// ===================================================================================

// 构建参数页上的检查参数（需要 Active Choices 插件）：
//   PRE_CHECKS / POST_CHECKS                 可多选的检查列表，默认选中 checkCatalog() 中的 defaults
//   PRE_CHECK_OPTIONS / POST_CHECK_OPTIONS   随选择变化的表单：每个选中的检查一组，包含失败处理方式和参数输入框
//   CHECK_PLAN                               YAML 格式的完整计划，非空时忽略上面四个参数；供 API / 上游 job 触发时使用
// 列表和表单由 Groovy 脚本在打开参数页时生成，脚本中嵌入了 checkCatalog() 的内容，在沙箱中运行，不需要审批。
def checkParameters() {
    String catalog = groovyLiteral(checkCatalog())
    List result = []
    [[phase: 'pre', title: '部署前'], [phase: 'post', title: '部署后']].each { Map p ->
        String name = p.phase.toUpperCase() + '_CHECKS'
        String optionsName = p.phase.toUpperCase() + '_CHECK_OPTIONS'
        result << activeChoice(name: name, randomName: 'choice-' + p.phase + '-checks',
                description: "${p.title}检查，可多选（按住 Ctrl 或 ⌘ 点击）。不选表示不检查",
                choiceType: 'PT_MULTI_SELECT', filterable: false, filterLength: 1,
                script: groovyScript(script: [classpath: [], sandbox: true, script: choicesScript(catalog, p.phase)],
                        fallbackScript: [classpath: [], sandbox: true, script: 'return ["（检查列表生成失败）"]']))
        result << activeChoiceHtml(name: optionsName, randomName: 'choice-' + p.phase + '-check-options',
                description: "所选${p.title}检查的失败处理方式和参数",
                choiceType: 'ET_FORMATTED_HTML', omitValueField: true, referencedParameters: name,
                script: groovyScript(script: [classpath: [], sandbox: true, script: optionsScript(catalog, name)],
                        fallbackScript: [classpath: [], sandbox: true, script: 'return "（表单生成失败）"']))
    }
    result << text(name: 'CHECK_PLAN', defaultValue: '', description: '''高级：YAML 格式的完整检查计划，非空时忽略上面的选择和表单。供 API / 上游 job 触发时使用，也可以让同一检查跑多次（用 id 区分）、设置 limit / timeout_minutes：
pre:
  - disk_space
  - {name: port_reachable, id: db, policy: warn, params: {target_port: 5432}}
post:
  - {name: http_health, policy: ask, limit: web1}''')
    return result
}

// 生成检查列表的脚本：返回 [检查名: 显示文字]，默认选中的项在显示文字后加 :selected（Active Choices 的约定）
@NonCPS
String choicesScript(String catalog, String phase) {
    return """def catalog = ${catalog}
def result = [:]
catalog.checks.each { name, c ->
    if ('${phase}' in c.phases) {
        result[name] = name + ' — ' + c.description + (name in catalog.defaults['${phase}'] ? ':selected' : '')
    }
}
return result
"""
}

// 生成参数表单的脚本。每个输入框前面放一个隐藏的标记 @@检查名.字段，提交时 Active Choices 会把
// 所有 name="value" 的输入框用逗号连成一个字符串，用标记切分，参数值里有逗号也不会错位
@NonCPS
String optionsScript(String catalog, String refParam) {
    return """def catalog = ${catalog}
def policies = [abort: '阻塞：失败即停止流水线', warn: '非阻塞：标记为不稳定后继续',
                ignore: '非阻塞：只记录，不影响结果', ask: '失败时暂停，由人决定是否继续']
def esc = { v -> String.valueOf(v).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;').replace("'", '&#39;') }
def selected = String.valueOf(${refParam} ?: '').tokenize(',').collect { it.trim() }.findAll { catalog.checks[it] }
if (!selected) {
    return '<div style="color:#6b7280">未选择检查</div>'
}
def html = []
selected.each { name ->
    def c = catalog.checks[name]
    html << '<div style="border:1px solid #d1d5db;border-radius:6px;padding:10px 14px;margin:0 0 10px 0">'
    html << '<div style="margin-bottom:8px"><b>' + esc(name) + '</b> <span style="color:#6b7280">' + esc(c.description) + '</span></div>'
    html << '<table>'
    html << '<tr><td style="padding:3px 12px 3px 0;white-space:nowrap">失败时</td><td style="padding:3px 0">'
    html << '<input type="hidden" name="value" value="@@' + esc(name) + '.policy">'
    html << '<select name="value" class="jenkins-select__input">'
    policies.each { p, label ->
        html << '<option value="' + p + '"' + (p == c.policy ? ' selected' : '') + '>' + p + '（' + label + '）</option>'
    }
    html << '</select></td></tr>'
    c.params.each { key, value ->
        def required = key in (c.required ?: [])
        def label = (c.labels ?: [:])[key] ?: ''
        html << '<tr><td style="padding:3px 12px 3px 0;white-space:nowrap">' + esc(key) + (required ? ' <span style="color:#dc2626">*</span>' : '') + '</td><td style="padding:3px 0">'
        html << '<input type="hidden" name="value" value="@@' + esc(name) + '.' + esc(key) + '">'
        html << '<input type="' + (value instanceof Number ? 'number' : 'text') + '" name="value" value="' + esc(value) + '" class="jenkins-input" style="width:360px">'
        html << ' <span style="color:#6b7280">' + esc(label) + '</span></td></tr>'
    }
    html << '</table></div>'
}
return html.join('')
"""
}

// 把 Map / List / 字符串 / 数字转成 Groovy 字面量，用于嵌入参数脚本
@NonCPS
String groovyLiteral(Object value) {
    if (value instanceof Map) {
        return value ? '[' + value.collect { k, v -> groovyLiteral(k.toString()) + ': ' + groovyLiteral(v) }.join(', ') + ']' : '[:]'
    }
    if (value instanceof Collection) {
        return '[' + value.collect { groovyLiteral(it) }.join(', ') + ']'
    }
    if (value instanceof Number || value instanceof Boolean || value == null) {
        return String.valueOf(value)
    }
    return "'" + value.toString().replace('\\', '\\\\').replace("'", "\\'").replace('\n', '\\n') + "'"
}

// 解析本次部署要运行的检查，返回 [pre: [...], post: [...]]。计划有误时让构建失败。
def resolveChecks(Map args) {
    Map catalog = checkCatalog()
    List errors = []
    Map plan = null
    if (args.plan?.trim()) {
        echo '[checks] 已提供 CHECK_PLAN，忽略构建参数页上的检查选择和表单'
        Object rawPlan = readYaml(text: args.plan)
        if (rawPlan instanceof Map) {
            plan = buildPlan(rawPlan, catalog, errors)
        } else {
            errors << 'CHECK_PLAN 必须是 YAML 映射（key: value）'
        }
    } else {
        Map rawPlan = [pre : selectionPlan(args.pre, args.preOptions, catalog, errors),
                       post: selectionPlan(args.post, args.postOptions, catalog, errors)]
        plan = buildPlan(rawPlan, catalog, errors)
    }
    if (errors) {
        error "[checks] 检查计划有误：\n  - " + errors.join('\n  - ')
    }
    echo describePlan(plan)
    return plan
}

// 依次运行一个阶段的检查，每个检查一个 stage；结果追加到 results
def runChecks(String phase, List checks, List results, Map context) {
    for (int i = 0; i < checks.size(); i++) {
        Map check = checks[i]
        stage("${phase}: ${check.id}") {
            runOneCheck(check, results, context)
        }
    }
}

def runOneCheck(Map check, List results, Map context) {
    echo "[checks] ${check.id}（${check.description}）策略=${check.policy} 参数=${check.params}"

    // 参数写进 JSON 文件，用 -e @file 传给 Ansible，这样能保留数字、布尔、列表的类型。
    // ansiblePlaybook 的 extraVars 只支持标量，而且会把数字变成字符串。
    String varsFile = ".deploy-checks/${check.phase}-${check.id}.json"
    writeJSON file: varsFile, json: context + check.params + [check_id: check.id, check_phase: check.phase]

    Map args = ansibleArgs() + [playbook: checksPlaybook(), tags: check.name,
                                extras  : "-e @${varsFile}"]
    if (check.limit) {
        args.limit = check.limit
    }

    long started = System.currentTimeMillis()
    String failure = null
    try {
        timeout(time: check.timeoutMinutes, unit: 'MINUTES') {
            ansiblePlaybook(args)
        }
    } catch (hudson.AbortException e) {
        // ansible-playbook 返回非 0（断言失败、主机不可达等）时，插件抛出 AbortException
        failure = e.message
    } catch (InterruptedException e) {
        // 超时按检查失败处理；手动中止构建照常抛出。timeout 取消 ansiblePlaybook 时插件抛出的是
        // 普通 InterruptedException，不带超时原因，所以用已耗时判断
        if (System.currentTimeMillis() - started < check.timeoutMinutes * 60000L) {
            throw e
        }
        failure = "超过 ${check.timeoutMinutes} 分钟未完成"
    }

    Map result = [id    : check.id, name: check.name, phase: check.phase, policy: check.policy,
                  params: check.params, seconds: (int) ((System.currentTimeMillis() - started) / 1000)]
    results << result
    if (failure == null) {
        result.status = 'PASSED'
        return
    }
    result.status = 'FAILED'
    result.message = failure
    String message = "检查 ${check.id} 未通过：${failure}"
    switch (check.policy) {
        case 'abort':
            result.outcome = 'aborted'
            error "${message}（阻塞检查，停止流水线）"
            break
        case 'warn':
            result.outcome = 'continued'
            unstable "${message}（非阻塞检查，继续执行）"
            break
        case 'ignore':
            result.outcome = 'ignored'
            echo "[checks] ${message}（已忽略）"
            break
        case 'ask':
            result.outcome = 'aborted'      // 点击“中止”或 30 分钟无人处理都会中止构建
            timeout(time: 30, unit: 'MINUTES') {
                input message: "${message}\n是否继续？", ok: '继续'
            }
            result.outcome = 'continued'
            unstable "${message}（人工确认继续）"
            break
    }
}

// 打印结果汇总，并归档 deploy-checks-report.json
def reportChecks(List results) {
    if (!results) {
        return
    }
    echo formatReport(results)
    writeJSON file: 'deploy-checks-report.json', json: results, pretty: 4
    archiveArtifacts artifacts: 'deploy-checks-report.json'
}

// 把一个阶段的检查选择（"a,b"）和表单内容转成与 CHECK_PLAN 相同的结构。
// 通过 API 触发时也可以只传选择，此时使用默认策略和参数；检查名后可加 :策略，如 "disk_space:warn"
@NonCPS
List selectionPlan(String selection, String options, Map catalog, List errors) {
    Map values = parseOptions(options)
    return (selection ?: '').tokenize(',').collect { it.trim() }.findAll { it }.collect { String item ->
        List parts = item.tokenize(':')
        String name = parts[0]
        Map entry = [name: name]
        if (parts.size() > 1) {
            entry.policy = parts[1]
        }
        if (values[name + '.policy']) {
            entry.policy = values[name + '.policy']
        }
        Map defaults = catalog.checks[name]?.params ?: [:]
        Map params = [:]
        values.each { String key, String value ->
            if (key.startsWith(name + '.') && key != name + '.policy') {
                String field = key.substring(name.length() + 1)
                params[field] = convertValue(value, defaults[field], "${name}.${field}", errors)
            }
        }
        if (params) {
            entry.params = params
        }
        return entry
    }
}

// 表单提交的内容形如 "@@disk_space.policy,abort,@@disk_space.path,/var"，转成 [disk_space.policy: abort, ...]。
// Active Choices 拼接时会按 JSON 字符串转义每个值（" 变成 \"，\ 变成 \\），这里还原
@NonCPS
Map parseOptions(String text) {
    Map values = [:]
    (text ?: '').split('(?:^|,)@@').each { String part ->
        int comma = part.indexOf(',')
        if (comma > 0) {
            values[part.substring(0, comma)] = jsonUnescape(part.substring(comma + 1))
        } else if (part) {
            values[part] = ''
        }
    }
    return values
}

@NonCPS
String jsonUnescape(String text) {
    Map simple = ['"': '"', '\\': '\\', '/': '/', 'b': '\b', 'f': '\f', 'n': '\n', 'r': '\r', 't': '\t']
    return text.replaceAll(/\\(u[0-9a-fA-F]{4}|.)/) { String all, String code ->
        code.length() == 5 ? String.valueOf((char) Integer.parseInt(code.substring(1), 16)) : (simple[code] ?: all)
    }
}

// 表单中的值都是字符串，按目录中默认值的类型转换
@NonCPS
Object convertValue(String value, Object defaultValue, String label, List errors) {
    if (defaultValue instanceof Number) {
        if (value.trim() ==~ /-?\d+/) {
            return value.trim().toLong()
        }
        errors << "参数 ${label} 应为整数，实际为 '${value}'"
        return value
    }
    if (defaultValue instanceof Boolean) {
        return value.trim().equalsIgnoreCase('true')
    }
    return value
}

// 校验计划，并与目录中的默认值合并；发现的问题追加到 errors
@NonCPS
Map buildPlan(Map rawPlan, Map catalog, List errors) {
    List entryKeys = ['name', 'id', 'policy', 'params', 'limit', 'timeout_minutes']
    List policies = ['abort', 'warn', 'ignore', 'ask']
    Map plan = [pre: [], post: []]
    List unknownPhases = rawPlan.keySet().findAll { !(it in ['pre', 'post']) } as List
    if (unknownPhases) {
        errors << "未知阶段 ${unknownPhases}，只支持 pre / post"
    }
    ['pre', 'post'].each { String phase ->
        Object entries = rawPlan[phase]
        if (entries == null) {
            return
        }
        if (!(entries instanceof List)) {
            errors << "${phase} 必须是列表"
            return
        }
        List ids = []
        entries.eachWithIndex { Object item, int index ->
            String where = "${phase}[${index}]"
            Object entry = item instanceof String ? [name: item] : item
            if (!(entry instanceof Map) || !entry.name) {
                errors << "${where}：应为检查名，或包含 name 的映射"
                return
            }
            List badKeys = entry.keySet().findAll { !(it in entryKeys) } as List
            if (badKeys) {
                errors << "${where}：不支持的字段 ${badKeys}，可用字段 ${entryKeys}"
            }
            Map definition = catalog.checks[entry.name]
            if (definition == null) {
                errors << "${where}：未知检查 '${entry.name}'，可用检查 ${catalog.checks.keySet()}"
                return
            }
            if (!(phase in definition.phases)) {
                errors << "${where}：检查 '${entry.name}' 不能用于 ${phase}，只能用于 ${definition.phases}"
            }
            String id = (entry.id ?: entry.name).toString()
            if (!(id ==~ /[A-Za-z0-9_.-]+/)) {
                errors << "${where}：id '${id}' 只能包含字母、数字、_ . -"
            } else if (id in ids) {
                errors << "${where}：id '${id}' 重复；同一检查运行多次时请用 id 区分"
            }
            ids << id
            String policy = (entry.policy ?: definition.policy).toString()
            if (!(policy in policies)) {
                errors << "${where}：未知策略 '${policy}'，可用策略 ${policies}"
            }
            Object given = entry.params ?: [:]
            if (!(given instanceof Map)) {
                errors << "${where}：params 必须是映射"
                return
            }
            List unknownParams = given.keySet().findAll { !definition.params.containsKey(it) } as List
            if (unknownParams) {
                errors << "${where}：检查 '${entry.name}' 不接受参数 ${unknownParams}，可用参数 ${definition.params.keySet()}"
            }
            Map merged = definition.params + given
            (definition.required ?: []).each { String key ->
                if (merged[key] == null || merged[key].toString().trim().isEmpty()) {
                    errors << "${where}：检查 '${entry.name}' 必须提供参数 ${key}"
                }
            }
            given.each { key, value ->
                if (containsTemplate(value)) {
                    // Ansible 会渲染 extra vars 中的 Jinja 表达式，可被用来在 Jenkins 节点上执行命令
                    errors << "${where}：参数 ${key} 不能包含 Jinja 模板语法（{{ / {% / {#）"
                }
            }
            plan[phase] << [id            : id, name: entry.name.toString(), phase: phase,
                            description   : definition.description, policy: policy, params: merged,
                            limit         : entry.limit?.toString(),
                            timeoutMinutes: (entry.timeout_minutes ?: definition.timeout_minutes) as int]
        }
    }
    return plan
}

@NonCPS
boolean containsTemplate(Object value) {
    if (value instanceof Map) {
        return value.any { k, v -> containsTemplate(k) || containsTemplate(v) }
    }
    if (value instanceof Collection) {
        return value.any { containsTemplate(it) }
    }
    String text = value?.toString() ?: ''
    return text.contains('{{') || text.contains('{%') || text.contains('{#')
}

@NonCPS
String describePlan(Map plan) {
    List lines = ['[checks] 本次部署的检查计划：']
    ['pre', 'post'].each { String phase ->
        lines << "  ${phase}:${plan[phase] ? '' : ' （无）'}"
        plan[phase].each { Map c ->
            lines << "    - ${c.id} [${c.policy}] ${c.params}${c.limit ? ' limit=' + c.limit : ''}"
        }
    }
    return lines.join('\n')
}

@NonCPS
String formatReport(List results) {
    List lines = ['[checks] 检查结果：']
    results.each { Map r ->
        lines << "  ${r.phase.padRight(5)} ${r.id.padRight(20)} ${r.policy.padRight(7)} ${r.status.padRight(7)}" +
                "${r.seconds.toString().padLeft(4)}s${r.outcome ? ' -> ' + r.outcome : ''}"
    }
    return lines.join('\n')
}
