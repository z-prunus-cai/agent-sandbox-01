// 部署流水线（方案 C：只用 Jenkins 自带参数类型，构建开始后用 input 步骤填写所选任务的参数）。
// 需要的插件：workflow-aggregator、ansible、pipeline-utility-steps、credentials-binding。
// 逻辑在 jenkins/deploy-engine.groovy，任务目录在 jenkins/tasks.yml，Ansible 代码在 ansible/。

// 按项目修改
Map settings = [
    baseDir: 'jenkins-ansible-deploy/examples',                  // 本目录在仓库中的路径
    ansible: [vaultCredentialsId: 'ansible-vault-password',      // Secret text：ansible-vault 密码
              sshCredentialsId  : 'deploy-ssh-key'],             // SSH Username with private key：连接目标主机；不需要时设为 null
]

def engine
Map request
Map plan
List results = []

pipeline {
    // 不在顶层分配执行器：等待 input 的 stage 不占执行器和工作区
    agent none

    stages {
        // 构建参数由 properties() 在这里写入 job，任务或主机组的变化从下一次构建起出现在参数页上
        stage('Prepare') {
            agent any
            steps {
                script {
                    engine = load "${settings.baseDir}/jenkins/deploy-engine.groovy"
                    request = engine.prepareRequest(settings, params, 'basic')
                }
            }
        }

        stage('Task options') {
            steps {
                script {
                    plan = engine.resolvePlan(request)
                }
            }
        }

        stage('Run') {
            agent any
            when {
                beforeAgent true
                expression { plan }
            }
            stages {
                stage('Pre-deploy tasks') {
                    when { expression { plan.pre } }
                    steps {
                        script {
                            engine.runTasks(plan, 'pre', results)
                        }
                    }
                }

                stage('Deploy') {
                    when { expression { !plan.skipDeploy } }
                    steps {
                        script {
                            engine.deploy(plan, results)
                        }
                    }
                }

                stage('Post-deploy tasks') {
                    when { expression { plan.post } }
                    steps {
                        script {
                            engine.runTasks(plan, 'post', results)
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        engine.report(results)
                    }
                }
            }
        }
    }
}
