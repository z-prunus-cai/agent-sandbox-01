# run-task.yml gets task_role and task_hosts from Jenkins at run time; the syntax check needs a value for each
extra_vars:
  task_role: task_a
  task_hosts: localhost
# business/tasks holds roles: without these, the meta/ and tests/ files under it count as task lists
kinds:
  - role-arg-spec: "**/business/tasks/*/meta/argument_specs.yml"
  - yaml: "**/business/tasks/*/meta/task.yml"
  - yaml: "**/business/tasks/*/tests/*.yml"
